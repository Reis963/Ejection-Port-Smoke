<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>EjectionPortSmoke</AssemblyName>
    <RootNamespace>EjectionPortSmoke</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>References\Tarkov\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>References\Bepinex\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>References\Tarkov\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>References\SPT\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>References\Tarkov\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>References\Tarkov\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>References\Tarkov\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true' and '$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageRoot>$(ProjectDir)release\EjectionPortSmoke</PackageRoot>
      <PackagePluginDir>$(PackageRoot)\BepInEx\plugins\EjectionPortSmoke</PackagePluginDir>
      <PackagePath>$(ProjectDir)release\EjectionPortSmoke-$(Version)-SPT-4.1.3.zip</PackagePath>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageRoot)" />
    <MakeDir Directories="$(PackagePluginDir)" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)..\README.md;$(ProjectDir)..\LICENSE" DestinationFolder="$(PackagePluginDir)" />
    <Delete Files="$(PackagePath)" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackagePath)" />
  </Target>
</Project>
